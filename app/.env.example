# GitHub App slug used to build the "Add to an existing repo" install link.
# Left unset until Task 5 registers the GitHub App.
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# Optional: throttle /api/add-toolkit per signed-in session. Defaults to 20
# requests per 10 minutes when unset.
ADD_TOOLKIT_RATE_LIMIT=
ADD_TOOLKIT_RATE_LIMIT_WINDOW_MS=
